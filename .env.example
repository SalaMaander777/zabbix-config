# Скопировать в .env и заполнить. .env в git не хранить.

# Версия Zabbix зафиксирована. Тег проверен на Docker Hub (alpine-7.0.32 существует
# для amd64). Менять только по решению заказчика.
ZBX_VERSION=7.0.32
PG_IMAGE=postgres:16-alpine

POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# Порт веб-интерфейса на главном компьютере (рабочие места: http://<IP>:<порт>)
WEB_PORT=80
PHP_TZ=Europe/Moscow

# Для скриптов API (post_setup.py, export_config.py) и карты. Сменить пароль Admin после первого входа
# и записать сюда новый.
ZBX_API_USER=Admin
ZBX_API_PASSWORD=zabbix

# Хранение, согласовано: история 90 дней, тренды 365 дней (тренды - требует согласования)
ZBX_HISTORY=90d
ZBX_TRENDS=365d

# Ёмкость кэшей под ~100 устройств
ZBX_CACHESIZE=128M
ZBX_STARTPOLLERS=10

# Лимит памяти PHP веб-интерфейса (по умолчанию 512M)
#ZBX_MEMORYLIMIT=512M

# Карта устройств (docker-compose.map.yml). Запуск:
#   docker compose -f docker-compose.yml -f docker-compose.map.yml up -d
# Порт карты на главном компьютере: http://<IP>:<порт>
MAP_PORT=8081
# Адрес веб-интерфейса Zabbix для ссылок из карточек карты, например http://192.168.1.10
# (без завершающего слэша). Пусто = тот же хост, порт 80 (если WEB_PORT изменён - указать явно).
ZBX_FRONTEND_URL=
