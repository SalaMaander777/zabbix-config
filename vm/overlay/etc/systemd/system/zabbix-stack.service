[Unit]
Description=Zabbix: запуск контейнеров при каждой загрузке
# firstboot (если ещё не выполнен) завершается раньше; без его маркера (.env нет) стек не стартуем
After=docker.service zabbix-firstboot.service
Wants=zabbix-firstboot.service
Requires=docker.service
ConditionPathExists=/var/lib/zabbix-firstboot.done

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/zabbix
ExecStart=/usr/bin/docker compose up -d --no-build
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
